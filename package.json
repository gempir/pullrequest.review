{
    "name": "pullrequestdotreview",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev --mode dev",
        "tsc": "tsc --noEmit",
        "check:fix": "biome check --write .",
        "check": "biome check .",
        "knip": "knip --include files,exports",
        "test": "bun test",
        "build": "vite build && cp dist/client/_shell.html dist/client/index.html",
        "serve": "vite preview",
        "worker:dev": "wrangler dev --config wrangler.jsonc",
        "worker:preview": "wrangler dev --config wrangler.jsonc --remote",
        "cf-typegen": "wrangler types",
        "deploy": "bun run build && wrangler deploy --config wrangler.jsonc",
        "secret:put:client-id": "wrangler secret put BITBUCKET_OAUTH_CLIENT_ID --config wrangler.jsonc",
        "secret:put:client-secret": "wrangler secret put BITBUCKET_OAUTH_CLIENT_SECRET --config wrangler.jsonc",
        "wrangler": "wrangler",
        "react-doctor": "react-doctor -y --verbose --offline src"
    },
    "dependencies": {
        "@pierre/diffs": "^1.5.2",
        "@pierre/trees": "^1.0.0-beta.6",
        "@platejs/basic-nodes": "^53.0.0",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/db": "^0.14.0",
        "@tanstack/react-db": "^0.5.9",
        "@tanstack/react-query": "^5.104.2",
        "@tanstack/react-router": "^1.170.44",
        "@tanstack/react-start": "^1.169.1",
        "@tanstack/react-table": "^9.3.1",
        "@tanstack/react-virtual": "^3.14.19",
        "@tanstack/rxdb-db-collection": "^0.1.108",
        "@tanstack/store": "^0.11.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "lucide-react": "^1.57.0",
        "platejs": "^53.3.15",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-markdown": "^10.1.0",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "rxdb": "^17.6.0",
        "shiki": "^4.5.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "valibot": "^1.5.0",
        "wrangler": "^4.151.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "knip": "^6.41.0",
        "react-doctor": "^0.9.18",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.4"
    },
    "resolutions": {
        "rxdb": "^17.6.0"
    },
    "trustedDependencies": [
        "@firebase/util",
        "esbuild",
        "protobufjs",
        "rxdb",
        "sharp",
        "workerd"
    ]
}
