{
    "compilerOptions": {
        "jsx": "react-jsx",
        "moduleResolution": "Bundler",
        "module": "ESNext",
        "allowImportingTsExtensions": true,
        "target": "ES2023",
        "skipLibCheck": true,
        "strictNullChecks": true,
        "paths": {
            "@/*": ["./src/*"]
        }
    }
}
